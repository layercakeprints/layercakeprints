---
import type { Product } from '@/lib/types';
import { formatPrice } from '@/lib/pricing';
import ProductArt from './ProductArt.astro';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}/p/${product.slug}`.replace(/\/{2,}/g, '/');
const leadText = `Ready in ~${product.lead_time_days} day${product.lead_time_days === 1 ? '' : 's'}`;
---

<a
  href={href}
  class="group block bg-card rounded-xl2 p-3 border border-line shadow-card transition-transform duration-200 hover:-translate-y-1 focus-visible:-translate-y-1"
  data-category={product.category}
>
  <div class="relative aspect-square rounded-2xl bg-paper overflow-hidden grid place-items-center">
    {product.featured && (
      <span class="sticker bg-bubble text-white absolute top-3 left-3 z-10">★ Popular</span>
    )}
    <ProductArt
      slug={product.slug}
      title={product.name}
      class="w-4/5 h-4/5 transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="px-1 pt-3 pb-1">
    <div class="flex items-baseline justify-between gap-2">
      <h3 class="text-lg leading-tight">{product.name}</h3>
      <span class="font-mono font-bold text-grape whitespace-nowrap">{formatPrice(product.price_gbp)}</span>
    </div>
    <p class="text-sm text-ink-soft mt-1 line-clamp-2">{product.short_description}</p>
    <span class="inline-block mt-2 text-xs font-semibold text-ink-soft">{leadText}</span>
  </div>
</a>
