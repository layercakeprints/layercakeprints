---
import { getArtInner } from '@/lib/productArt';

interface Props {
  slug: string;
  class?: string;
  title?: string;
  style?: string;
}
const { slug, class: className = '', title, style } = Astro.props;
const inner = getArtInner(slug);
---

<svg
  class={className}
  style={style}
  viewBox="0 0 200 200"
  role="img"
  aria-label={title ?? 'Product illustration'}
  xmlns="http://www.w3.org/2000/svg"
  set:html={inner}
/>
