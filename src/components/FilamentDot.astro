---
import type { FilamentColor } from '@/lib/types';

interface Props {
  color: FilamentColor;
  /** Show the colour name beside the dot (default true). */
  showName?: boolean;
  size?: number;
}
const { color, showName = true, size = 22 } = Astro.props;

// Finish is conveyed with text too (not colour alone) for accessibility.
const finishLabel: Record<FilamentColor['finish'], string> = {
  matte: 'Matte',
  silk: 'Silk',
  glow: 'Glow',
  transparent: 'Clear',
  multicolor: 'Rainbow',
};

const style = `width:${size}px;height:${size}px;background:${color.hex};`;
---

<span class:list={['inline-flex items-center gap-2', !color.in_stock && 'opacity-40']}>
  <span
    class="relative inline-block rounded-full border-2 border-ink/20 shrink-0"
    style={style}
    data-finish={color.finish}
    aria-hidden="true"
  >
    {color.finish === 'glow' && <span class="absolute inset-0 rounded-full ring-2 ring-lime/70"></span>}
    {color.finish === 'transparent' && <span class="absolute inset-0 rounded-full border border-white/70"></span>}
  </span>
  {showName && (
    <span class="text-sm">
      <span class="font-medium">{color.name}</span>
      <span class="text-ink-soft"> &middot; {finishLabel[color.finish]}</span>
      {!color.in_stock && <span class="text-ink-soft italic"> (out of stock)</span>}
    </span>
  )}
</span>
