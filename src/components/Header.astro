---
import { site } from '@/config/site';
import { getCatalog } from '@/lib/catalog';
import CartDrawer from '@/components/islands/CartDrawer.tsx';
const base = import.meta.env.BASE_URL;
const home = base.replace(/\/$/, '') || '/';
const { colors } = await getCatalog();
---

<header class="sticky top-0 z-40 bg-paper/85 backdrop-blur border-b border-line">
  <div class="mx-auto max-w-5xl px-4 h-16 flex items-center justify-between gap-4">
    <a href={home} class="flex items-center gap-2 font-display text-lg sm:text-xl font-extrabold tracking-tight">
      <span class="inline-grid place-items-center w-8 h-8 rounded-xl bg-grape rotate-[-6deg] shrink-0">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="4" y="14" width="16" height="4" rx="2" fill="#fff"/>
          <rect x="6" y="9" width="12" height="4" rx="2" fill="#c4b5fd"/>
          <rect x="8" y="4" width="8" height="4" rx="2" fill="#fff"/>
        </svg>
      </span>
      <span>{site.name}</span>
    </a>

    <CartDrawer client:load colors={colors} />
  </div>
</header>
