---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CheckoutForm from '@/components/islands/CheckoutForm.tsx';
import { getCatalog } from '@/lib/catalog';

const { colors } = await getCatalog();
---

<BaseLayout title="Checkout">
  <Header slot="header" />
  <section class="mx-auto max-w-5xl px-4 py-8">
    <h1 class="text-3xl font-extrabold mb-6">Checkout</h1>
    <CheckoutForm client:load colors={colors} />
  </section>
  <Footer slot="footer" />
</BaseLayout>
