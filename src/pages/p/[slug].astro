---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ColorConfigurator from '@/components/islands/ColorConfigurator.tsx';
import { getCatalog } from '@/lib/catalog';
import type { FilamentColor, Product } from '@/lib/types';

export async function getStaticPaths() {
  const { products, colors } = await getCatalog();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, colors },
  }));
}

interface Props {
  product: Product;
  colors: FilamentColor[];
}
const { product, colors } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = base.replace(/\/$/, '') || '/';

const allowed = colors.filter((c) => product.allowed_color_ids.includes(c.id));
const configProduct = {
  id: product.id,
  slug: product.slug,
  name: product.name,
  description: product.description,
  price_gbp: product.price_gbp,
  lead_time_days: product.lead_time_days,
  featured: product.featured,
  color_slots: product.color_slots,
  slot_labels: product.slot_labels,
};
---

<BaseLayout title={product.name} description={product.short_description}>
  <Header slot="header" />

  <article class="mx-auto max-w-5xl px-4 py-6">
    <a href={`${home}#shop`} class="inline-flex items-center gap-1 text-sm font-semibold text-ink-soft hover:text-grape">
      <span aria-hidden="true">&larr;</span> Back to shop
    </a>

    <div class="mt-4">
      <!-- client:load island; Astro also server-renders it, so the product is
           visible (with default colours) even without JavaScript. -->
      <ColorConfigurator client:load product={configProduct} colors={allowed} />
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>
